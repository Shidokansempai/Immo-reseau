# ─── Base ──────────────────────────────────────────────────────────────────
# SQLite en développement (zéro configuration). En production, remplacer par
# une URL PostgreSQL : postgresql://user:pass@host:5432/immoassist
DATABASE_URL="file:./dev.db"

# Secret de signature des sessions (JWT). OBLIGATOIRE. Générer avec :
#   openssl rand -base64 32
AUTH_SECRET="dev-secret-change-me-in-production-please-32chars-min"

# ─── Intégrations externes (optionnelles — architecture prête) ───────────────
# Renseignez ces clés plus tard depuis l'interface Paramètres > Intégrations.
# Elles ne sont JAMAIS exposées au frontend : usage serveur uniquement.

# IA (assistant + génération de contenu). Sans clé, un moteur local de secours
# répond déjà aux questions courantes sur vos données.
AI_PROVIDER=""              # "anthropic" | "openai" | "" (désactivé)
AI_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# Données immobilières DVF (avis de valeur) — transactions réelles.
# Vide = échantillon de démonstration hors ligne puis grille marché locale.
#
# Fournisseur (recommandé : l'API OFFICIELLE, sans clé) :
#   DVF_PROVIDER="data_economie"
# → data.economie.gouv.fr (Ministère de l'Économie, données DGFiP),
#   API Opendatasoft Explore v2, interrogée par code commune.
#   Dataset par défaut "demandes-de-valeurs-foncieres" ; ajustez si besoin :
#   DVF_ODS_DATASET="demandes-de-valeurs-foncieres"
#   DVF_ODS_BASE="https://data.economie.gouv.fr"
#
# Autres fournisseurs :
#   DVF_PROVIDER="cquest"                       # API communautaire cquest
#   DVF_API_URL="https://backend/mutations?insee={insee}"  # backend custom
#   (DVF_API_URL prime sur DVF_PROVIDER ; {insee} injecté, sinon ?code_commune=)
# DVF_API_KEY est optionnel (en-tête Authorization: Bearer, backend custom).
DVF_PROVIDER=""
DVF_ODS_DATASET=""
DVF_ODS_BASE=""
DVF_API_URL=""
DVF_API_KEY=""

# Communication
SMTP_URL=""                 # smtp://user:pass@host:587
WHATSAPP_API_URL=""
WHATSAPP_API_KEY=""

# Paiements SaaS
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Cartographie
MAPBOX_TOKEN=""
GOOGLE_MAPS_KEY=""
