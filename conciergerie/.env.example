# Port HTTP
PORT=3000
# Fichier de base de données SQLite
DATABASE_FILE=./data/conciergerie.db
# Mettre à true derrière HTTPS (cookie sécurisé)
COOKIE_SECURE=false
# Désactiver la création de nouveaux comptes conciergerie
ALLOW_SIGNUP=true

# SMTP global (optionnel : chaque conciergerie peut aussi saisir le sien dans Paramètres)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
